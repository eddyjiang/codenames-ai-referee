{
  "name": "codenames-rules-guy",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "worker"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:worker\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:worker": "npm run dev --workspace=worker",
    "build": "npm run build --workspace=frontend && npm run build --workspace=worker",
    "deploy": "npm run deploy --workspace=worker",
    "db:migrate": "wrangler d1 migrations apply codenames-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply codenames-db"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.21.5"
  }
}
